# NeoPeptide — Environment Configuration
# Copy this file to .env and edit as needed

# Backend URL — used by the browser to reach the FastAPI backend
# Use http://localhost:8000 on all platforms (browser connects from host)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend port (exposed to host)
BACKEND_PORT=8000

# Frontend port (exposed to host)
FRONTEND_PORT=3000
